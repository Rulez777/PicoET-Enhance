# Magisk policy statements: allow source target class permission (no ':' or ';').
# Enforcing support still requires device validation. Reinstall the module and reboot
# after changing this file so Magisk rebuilds and loads its preinit policy bundle.

# ptrace injection: magisk (su / service.sh) -> pxreyetrackingservice
allow magisk pxreyetrackingservice process { ptrace signal sigkill }
# /proc/<pid> metadata; PTRACE_PEEKDATA/POKEDATA use process ptrace, not a mem class.
allow magisk pxreyetrackingservice dir { search open read getattr }
allow magisk pxreyetrackingservice file { open read getattr }
allow magisk pxreyetrackingservice fd use

# dlopen traverses /data/adb (adb_data_file) before the module tree (system_file).
allow pxreyetrackingservice adb_data_file dir search
allow pxreyetrackingservice system_file dir search

# payload: mode/gate files, log and atomic runtime reports in /data/local/tmp
allow pxreyetrackingservice shell_data_file dir { search read open getattr write add_name remove_name }
allow pxreyetrackingservice shell_data_file file { open read write create append getattr rename unlink }

# payload: map/execute our own injected library (module dir -> system_file)
allow pxreyetrackingservice system_file file { open read getattr execute map }

# runtime code patching of the plugin: mprotect RWX / COW-exec (execmod)
allow pxreyetrackingservice system_lib_file file execmod
allow pxreyetrackingservice pxreyetrackingservice process execmem
